# Public API keys for the RePoT CLI. Copy this file to `.env` and fill in
# whichever providers you want to use. None of these are required for
# offline smoke runs against `local_dummy`.

# --- OpenAI Responses API (gpt_5_4_mini and friends) -------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic Messages API (Claude) ------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Gemini -----------------------------------------------------
# Public Gemini API:
#   https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Or Vertex AI (set both if using Vertex):
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- vLLM / OpenAI-compatible endpoint (open-weights) -------------------
# Bring up the model with `vllm serve <model>` and point these at it.
REPOT_OPENAI_BASE_URL=http://localhost:8000/v1
REPOT_API_KEY=EMPTY
